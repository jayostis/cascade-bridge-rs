@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix oa:      <http://www.w3.org/ns/oa#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

[] a oa:Annotation ;
  oa:hasTarget [
    oa:hasSource <../in/list.json> ;
    oa:hasSelector [
      a oa:FragmentSelector ;
      dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
      rdf:value "/items/1" ;
      oa:refinedBy [ a oa:FragmentSelector ; dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ; rdf:value "/title" ]
    ]
  ] ;
  oa:hasBody <https://datatracker.ietf.org/doc/html/draft-wright-json-schema-validation-01#section-6.25> ;
  oa:motivatedBy oa:classifying ;
  sh:resultSeverity sh:Violation .

[] a oa:Annotation ;
  oa:hasTarget [
    oa:hasSource <../in/list.json> ;
    oa:hasSelector [
      a oa:FragmentSelector ;
      dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
      rdf:value "/items/1" ;
      oa:refinedBy [ a oa:FragmentSelector ; dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ; rdf:value "/extra" ]
    ]
  ] ;
  oa:hasBody bridge:pathNotAccounted ;
  oa:motivatedBy oa:classifying ;
  sh:value "/extra" ;
  sh:resultSeverity sh:Info .

[] a oa:Annotation ;
  oa:hasTarget [
    oa:hasSource <../in/list.json> ;
    oa:hasSelector [
      a oa:FragmentSelector ;
      dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
      rdf:value "/items/1" ;
      oa:refinedBy [ a oa:FragmentSelector ; dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ; rdf:value "/extra/a" ]
    ]
  ] ;
  oa:hasBody bridge:pathNotAccounted ;
  oa:motivatedBy oa:classifying ;
  sh:value "/extra/a" ;
  sh:resultSeverity sh:Info .
