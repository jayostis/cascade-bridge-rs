@prefix ex:   <urn:example:list#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:example:item:1> a ex:Item ; ex:title "one" .
<urn:example:item:2> a ex:Item ; ex:title "2.50" .

<ni:///sha-256;av2wWqSkSXNAHcfJc4uh98wFs47XirXgZ1NAaR7LQBM> a prov:Entity .

[] a prov:Activity ;
  prov:used <ni:///sha-256;av2wWqSkSXNAHcfJc4uh98wFs47XirXgZ1NAaR7LQBM> ;
  prov:qualifiedAssociation [
    prov:hadPlan [ a prov:Plan ; rdfs:label "list" ] ;
    prov:agent [ ]
  ] .
