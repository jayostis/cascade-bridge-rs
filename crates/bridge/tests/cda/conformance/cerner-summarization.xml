<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cerner PowerChart summarization fixture (P4-F).

  Demonstrates Cerner-specific quirks:
  1. Problem and allergy acts include both <setId> and <id> elements (Cerner tracking IDs).
     The converter accesses act.id[0] for the sourceRecordId; setId is ignored.
  2. Observations in the problems section use the standard entryRelationship pattern.

  Note: No <custodian> element is present to avoid a known parse limitation where
  the <name> element is always wrapped in an array by fast-xml-parser.
-->
<ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <realmCode code="US"/>
  <typeId root="2.16.840.1.113883.1.3" extension="POCD_HD000040"/>
  <templateId root="2.16.840.1.113883.10.20.22.1.1"/>
  <id root="2.16.840.1.113883.3.88.11.32.1" extension="CERNER-SUMMARY-FIXTURE-001"/>
  <code code="34133-9" displayName="Summarization of Episode Note" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC"/>
  <title>Health Summary</title>
  <effectiveTime value="20260327120000+0000"/>
  <confidentialityCode code="N" codeSystem="2.16.840.1.113883.5.25"/>
  <languageCode code="en-US"/>
  <recordTarget>
    <patientRole>
      <id root="2.16.840.1.113883.4.1" extension="000-00-0000"/>
      <patient>
        <name use="L"><given>Jane</given><family>Doe</family></name>
        <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1"/>
        <birthTime value="19650101"/>
      </patient>
    </patientRole>
  </recordTarget>
  <component>
    <structuredBody>
      <!-- Problems Section — Cerner uses setId alongside id for tracking -->
      <component>
        <section>
          <templateId root="2.16.840.1.113883.10.20.22.2.5.1"/>
          <code code="11450-4" displayName="Problem List" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC"/>
          <title>Problems</title>
          <text>Chronic Kidney Disease, Stage 2 - Active</text>
          <entry typeCode="DRIV">
            <act classCode="ACT" moodCode="EVN">
              <templateId root="2.16.840.1.113883.10.20.22.4.3"/>
              <!-- Cerner quirk: setId present alongside id at the act level -->
              <setId root="2.16.840.1.113883.3.88.11.32.1" extension="CERNER-COND-SET-001"/>
              <id root="2.16.840.1.113883.3.88.11.32.1" extension="CERNER-COND-001"/>
              <code code="CONC" codeSystem="2.16.840.1.113883.5.6"/>
              <statusCode code="active"/>
              <effectiveTime>
                <low value="20230101"/>
              </effectiveTime>
              <entryRelationship typeCode="SUBJ">
                <observation classCode="OBS" moodCode="EVN">
                  <templateId root="2.16.840.1.113883.10.20.22.4.4"/>
                  <!-- Cerner quirk: observation also has setId -->
                  <setId root="2.16.840.1.113883.3.88.11.32.1" extension="CERNER-COND-OBS-SET-001"/>
                  <id root="2.16.840.1.113883.3.88.11.32.1" extension="CERNER-COND-OBS-001"/>
                  <code code="55607006" displayName="Problem" codeSystem="2.16.840.1.113883.6.96"/>
                  <statusCode code="completed"/>
                  <effectiveTime>
                    <low value="20230101"/>
                  </effectiveTime>
                  <value xsi:type="CD" code="N18.2" displayName="Chronic kidney disease, stage 2 (mild)" codeSystem="2.16.840.1.113883.6.90" codeSystemName="ICD-10"/>
                </observation>
              </entryRelationship>
            </act>
          </entry>
        </section>
      </component>
      <!-- Allergies Section — Cerner setId quirk applies here too -->
      <component>
        <section>
          <templateId root="2.16.840.1.113883.10.20.22.2.6.1"/>
          <code code="48765-2" displayName="Allergies and Adverse Reactions" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC"/>
          <title>Allergies and Adverse Reactions</title>
          <text>Aspirin - Mild</text>
          <entry typeCode="DRIV">
            <act classCode="ACT" moodCode="EVN">
              <templateId root="2.16.840.1.113883.10.20.22.4.30"/>
              <!-- Cerner: setId present alongside id -->
              <setId root="2.16.840.1.113883.3.88.11.32.1" extension="CERNER-ALLERGY-SET-001"/>
              <id root="2.16.840.1.113883.3.88.11.32.1" extension="CERNER-ALLERGY-001"/>
              <code code="CONC" codeSystem="2.16.840.1.113883.5.6"/>
              <statusCode code="active"/>
              <observation classCode="OBS" moodCode="EVN">
                <templateId root="2.16.840.1.113883.10.20.22.4.7"/>
                <id root="2.16.840.1.113883.3.88.11.32.1" extension="CERNER-ALLERGY-OBS-001"/>
                <code code="ASSERTION" codeSystem="2.16.840.1.113883.5.4"/>
                <statusCode code="completed"/>
                <value xsi:type="CD" code="416098002" displayName="Drug allergy" codeSystem="2.16.840.1.113883.6.96"/>
                <participant typeCode="CSM">
                  <participantRole classCode="MANU">
                    <playingEntity classCode="MMAT">
                      <code code="1191" displayName="Aspirin" codeSystem="2.16.840.1.113883.6.88"/>
                      <name>Aspirin</name>
                    </playingEntity>
                  </participantRole>
                </participant>
                <entryRelationship typeCode="SUBJ" inversionInd="true">
                  <observation classCode="OBS" moodCode="EVN">
                    <templateId root="2.16.840.1.113883.10.20.22.4.8"/>
                    <code code="SEV" displayName="Severity Observation" codeSystem="2.16.840.1.113883.5.4"/>
                    <statusCode code="completed"/>
                    <value xsi:type="CD" code="255604002" displayName="Mild" codeSystem="2.16.840.1.113883.6.96"/>
                  </observation>
                </entryRelationship>
              </observation>
            </act>
          </entry>
        </section>
      </component>
    </structuredBody>
  </component>
</ClinicalDocument>
