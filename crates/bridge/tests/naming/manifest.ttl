<#claim-star-with-a-table> a bridge:NamingTest ;
  mf:name "claim-star-with-a-table" ;
  rdfs:comment "A star of three members, and used holding the table version the rule read." ;
  bridge:namingRule cascade:ClaimNamingRule ;
  mf:action [ bridge:nameInputs ( "https://ns.cascadeprotocol.org/cascade#CascadeMatcher" "https://ns.cascadeprotocol.org/cascade#SameMappedCodeAndDateRule" "https://ns.cascadeprotocol.org/cascade#SameMappedCodeAndDate" ("urn:uuid:351ccd8a-d25c-83d4-8025-988b8769088e" "urn:uuid:7435b3b8-2d93-8912-9d48-940c5870dc81" "urn:uuid:f83d6a9d-1d0e-84bd-826c-e3f00989c291") ("ni:///sha-256;7UF52nyQz5_3t_7QQn6dXsLuxB5n3HfJcDLlONA8eN4" "ni:///sha-256;Q2zb2hq5EC43OWgfnQ-uPPQDVO6_EFXtdyhjpb_8PnQ" "ni:///sha-256;AowVyYvDuw_s7SL5fEFIF0Sy5DmeBCX3aiqrEebgB6w" "ni:///sha-256;eplyjFwBziuuDGwAXYG-OsnSc_l9nZRWlgn28AA-riY") ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:a92032b7-b56c-874e-8787-0cf9266e2309> ] .

<#claim-repeated-member-and-used> a bridge:NamingTest ;
  mf:name "claim-repeated-member-and-used" ;
  rdfs:comment "The first claim's inputs with a member and a used version listed twice: lists are sets, so it is the first claim's name." ;
  bridge:namingRule cascade:ClaimNamingRule ;
  mf:action [ bridge:nameInputs ( "https://ns.cascadeprotocol.org/cascade#CascadeMatcher" "https://ns.cascadeprotocol.org/cascade#SameCodeRule" "https://ns.cascadeprotocol.org/cascade#SameCode" ("urn:uuid:f83d6a9d-1d0e-84bd-826c-e3f00989c291" "urn:uuid:7435b3b8-2d93-8912-9d48-940c5870dc81" "urn:uuid:f83d6a9d-1d0e-84bd-826c-e3f00989c291") ("ni:///sha-256;eplyjFwBziuuDGwAXYG-OsnSc_l9nZRWlgn28AA-riY" "ni:///sha-256;Q2zb2hq5EC43OWgfnQ-uPPQDVO6_EFXtdyhjpb_8PnQ" "ni:///sha-256;Q2zb2hq5EC43OWgfnQ-uPPQDVO6_EFXtdyhjpb_8PnQ") ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:35ee949a-9a6f-8cbb-81ef-378e145711f0> ] .

<#snapshot-first> a bridge:NamingTest ;
  mf:name "snapshot-first" ;
  rdfs:comment "A writer's first snapshot: the act it is the snapshot of, no first parent and no merged parent, each an empty list written as 0, then the set hash as given." ;
  bridge:namingRule cascade:SnapshotNamingRule ;
  mf:action [ bridge:nameInputs ( "urn:uuid:2b7d4e61-9c3a-4f85-a1d0-6e8b3c5f7a92" () () "a1f0c3d5e7b9a2c4d6e8f0a1b3c5d7e9f1a3b5c7d9e1f3a5b7c9d1e3f5a7b9c1" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:80f74e0e-9e93-8fa5-848a-66e1cf1bd5c3> ] .

<#snapshot-next> a bridge:NamingTest ;
  mf:name "snapshot-next" ;
  rdfs:comment "The writer's next snapshot: its act and its first parent." ;
  bridge:namingRule cascade:SnapshotNamingRule ;
  mf:action [ bridge:nameInputs ( "urn:uuid:8e3c5a17-4d2b-4f69-9a0e-7b1d6c3f5e28" ("urn:uuid:0d6c1a52-3b7e-8f41-9a2c-5e8b7d4f1c30") () "b2e1d4c6f8a0b3d5e7f9a1c2e4d6f8b0a2c4e6f8b1d3f5a7c9e1b3d5f7a9c1e3" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:6e770e37-0a96-8bdb-a134-afc26cbd883a> ] .

<#snapshot-merge> a bridge:NamingTest ;
  mf:name "snapshot-merge" ;
  rdfs:comment "A sync's snapshot: its act, its first parent and the two heads that arrived, listed here unsorted." ;
  bridge:namingRule cascade:SnapshotNamingRule ;
  mf:action [ bridge:nameInputs ( "urn:uuid:c5f1a8d3-2e7b-4c94-8d06-3a9e5b2f7c41" ("urn:uuid:0d6c1a52-3b7e-8f41-9a2c-5e8b7d4f1c30") ("urn:uuid:a3b8c5d2-7e1f-8946-8c0b-1f4e6d9a2c57" "urn:uuid:4e9f2b71-6c3d-8a05-b1e7-2d9c8f6a3b14") "c3f2e5d7a9b1c4e6f8a0b2d3f5e7a9c1b3d5f7e9a2c4e6b8d0f2a4c6e8b1d3f5" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:01767588-66a0-826e-8d2a-8e35a9576899> ] .

<#snapshot-merge-by-another-writer> a bridge:NamingTest ;
  mf:name "snapshot-merge-by-another-writer" ;
  rdfs:comment "Another writer's sync over the same heads reaching the same set: another act, so another snapshot." ;
  bridge:namingRule cascade:SnapshotNamingRule ;
  mf:action [ bridge:nameInputs ( "urn:uuid:51d9e2b4-8a6c-4e37-b2f0-9c4a7e1d3b65" ("urn:uuid:0d6c1a52-3b7e-8f41-9a2c-5e8b7d4f1c30") ("urn:uuid:a3b8c5d2-7e1f-8946-8c0b-1f4e6d9a2c57" "urn:uuid:4e9f2b71-6c3d-8a05-b1e7-2d9c8f6a3b14") "c3f2e5d7a9b1c4e6f8a0b2d3f5e7a9c1b3d5f7e9a2c4e6b8d0f2a4c6e8b1d3f5" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:9bc7e3ff-35f2-878b-981a-b03f32617c28> ] .

<#version> a bridge:NamingTest ;
  mf:name "version" ;
  rdfs:comment "A version: the SHA-256 of the RDFC-1.0 canonical N-Quads of its triples, its subject urn:cascade:this-version, prov:specializationOf its record among them." ;
  bridge:namingRule cascade:VersionNamingRule ;
  mf:action [ bridge:input <content/version.nt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;79qujwwA5pwIANwZGiRTK0GbMw0kE6P9xu3Rl0qg6ZE> ; bridge:canonicalContent <content/version.nq> ] .

<#version-nested-identifiers> a bridge:NamingTest ;
  mf:name "version-nested-identifiers" ;
  rdfs:comment "Business identifiers nested on fragments of the placeholder, inside the version's content." ;
  bridge:namingRule cascade:VersionNamingRule ;
  mf:action [ bridge:input <content/version-nested-identifiers.nt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;uv1iTouwACLUN_Gn8j72BJbFAOtaSb5E2TpQYrPflPc> ; bridge:canonicalContent <content/version-nested-identifiers.nq> ] .

<#version-literal-forms> a bridge:NamingTest ;
  mf:name "version-literal-forms" ;
  rdfs:comment "Literals as RDFC-1.0 writes them: a language tag, a typed literal's lexical form kept as written, an escaped quotation mark, backslash, tab, line feed, carriage return, backspace and form feed, the other control characters as \\u and four upper-case hex digits, and non-ASCII characters as themselves." ;
  bridge:namingRule cascade:VersionNamingRule ;
  mf:action [ bridge:input <content/version-literal-forms.nt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;eoolDtMrrpjtrkxLiqo0g1hSYTMNYYSw2oGeTuhVZ5w> ; bridge:canonicalContent <content/version-literal-forms.nq> ] .

<#version-language-tag-case> a bridge:NamingTest ;
  mf:name "version-language-tag-case" ;
  rdfs:comment "A language tag written in mixed case is hashed in lower case, as Oxigraph's RDFC-1.0 writes it: BCP 47 tags are case-insensitive." ;
  bridge:namingRule cascade:VersionNamingRule ;
  mf:action [ bridge:input <content/version-language-tag-case.nt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;YZvBMln2ccupi06IT5zkjwmaSa6hbU_wHF5VC2w2yAk> ; bridge:canonicalContent <content/version-language-tag-case.nq> ] .

<#version-code-point-order> a bridge:NamingTest ;
  mf:name "version-code-point-order" ;
  rdfs:comment "Canonical lines are in code point order: U+FF5E (a UTF-16 unit of 0xFF5E) before U+1F600 (a surrogate pair starting 0xD83D), which a UTF-16 sort would put the other way round." ;
  bridge:namingRule cascade:VersionNamingRule ;
  mf:action [ bridge:input <content/version-code-point-order.nt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;K8Z4H3UpO4nZMzq3OyssdbKrQmaL1mp_7TuYvUTrceA> ; bridge:canonicalContent <content/version-code-point-order.nq> ] .

<#version-repeated-triple> a bridge:NamingTest ;
  mf:name "version-repeated-triple" ;
  rdfs:comment "A triple written twice is one triple: a graph is a set, so its canonical form holds one line for it." ;
  bridge:namingRule cascade:VersionNamingRule ;
  mf:action [ bridge:input <content/version-repeated-triple.nt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;wozFEeN9darCg3lk8CQBiPSn3eDcKBQ5mGYYTo0xagw> ; bridge:canonicalContent <content/version-repeated-triple.nq> ] .

<#revision> a bridge:NamingTest ;
  mf:name "revision" ;
  rdfs:comment "A revision: the same hash over its triples, its subject urn:cascade:this-revision." ;
  bridge:namingRule cascade:RevisionNamingRule ;
  mf:action [ bridge:input <content/revision.nt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;HTiLmGhUF1bggRnXC4kHY5LvWcHPWGCixV9yDxSO8NQ> ; bridge:canonicalContent <content/revision.nq> ] .

<#revision-with-selector> a bridge:NamingTest ;
  mf:name "revision-with-selector" ;
  rdfs:comment "A revision of a record named by its document: the arrival's oa:hasSource and prov:wasDerivedFrom are kept, and its selector is the revision's own node, urn:cascade:this-revision#selector, hashed under the placeholder." ;
  bridge:namingRule cascade:RevisionNamingRule ;
  mf:action [ bridge:input <content/revision-with-selector.nt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;w3JLCnjHuRIR5yzsamDfTnL4qjNb8ksy0orBhJUyoWQ> ; bridge:canonicalContent <content/revision-with-selector.nq> ] .

<#finding> a bridge:NamingTest ;
  mf:name "finding" ;
  rdfs:comment "A finding: the same hash over its triples, its subject urn:cascade:this-finding." ;
  bridge:namingRule cascade:FindingNamingRule ;
  mf:action [ bridge:input <content/finding.nt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;bqnyRwmKdjmRhV0qt5Xl0YAuCsHQ-c3tRyF1ubbci08> ; bridge:canonicalContent <content/finding.nq> ] .

<#table-version-first> a bridge:NamingTest ;
  mf:name "table-version-first" ;
  rdfs:comment "A table version: the same hash over prov:specializationOf its series and its rows; the first of its series revises none." ;
  bridge:namingRule cascade:TableVersionNamingRule ;
  mf:action [ bridge:input <content/table-version-first.nt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;CNCAFjR0KWVCB_N9Zs2tG2LxZpjaNHQICfzX0njWSDk> ; bridge:canonicalContent <content/table-version-first.nq> ] .

<#table-version-revising> a bridge:NamingTest ;
  mf:name "table-version-revising" ;
  rdfs:comment "A later version adds prov:wasRevisionOf the version it revises." ;
  bridge:namingRule cascade:TableVersionNamingRule ;
  mf:action [ bridge:input <content/table-version-revising.nt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;-m1e_MMhJrP2F1_gpDEx-f89god5jvK6RUPJ_5znO1c> ; bridge:canonicalContent <content/table-version-revising.nq> ] .

<#document-empty> a bridge:NamingTest ;
  mf:name "document-empty" ;
  rdfs:comment "A document of no bytes." ;
  bridge:namingRule cascade:DocumentNamingRule ;
  mf:action [ bridge:input <documents/empty.txt> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;47DEQpj8HBSa-_TImW-5JCeuQeRkm5NMpJWZG3hSuFU> ] .

<#document-json> a bridge:NamingTest ;
  mf:name "document-json" ;
  rdfs:comment "A document is named by its bytes as stored: here UTF-8 JSON holding non-ASCII text." ;
  bridge:namingRule cascade:DocumentNamingRule ;
  mf:action [ bridge:input <documents/bundle.json> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;YQegEpoI2h-HsDrlPr9eY5CfRQaXO6w7NxaRd_LlRz8> ] .

<#document-xml> a bridge:NamingTest ;
  mf:name "document-xml" ;
  rdfs:comment "A C-CDA document's bytes." ;
  bridge:namingRule cascade:DocumentNamingRule ;
  mf:action [ bridge:input <documents/ccda.xml> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;rI8RvPLLLr0GOayilGaTaGrcFv0NGQVl_ui-3zczOFY> ] .

<#document-crlf> a bridge:NamingTest ;
  mf:name "document-crlf" ;
  rdfs:comment "A document's line endings are its bytes: the same XML with CR LF names another document." ;
  bridge:namingRule cascade:DocumentNamingRule ;
  mf:action [ bridge:input <documents/ccda-crlf.xml> ] ;
  mf:result [ bridge:expectedName <ni:///sha-256;7E93HjzUpIsj03U1no7aBRe915k0-usXDikwTJNdyuM> ] .

<#base-url-case> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-case" ;
  rdfs:comment "The scheme and host in lower case; the path as written." ;
  mf:action [ cascade:serverBaseUrl "HTTPS://FHIR.Example.ORG/api/FHIR/R4" ] ;
  mf:result [ cascade:serverBaseUrl "https://fhir.example.org/api/FHIR/R4" ] .

<#base-url-default-port-and-slashes> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-default-port-and-slashes" ;
  rdfs:comment "The scheme's default port dropped, and every trailing / removed." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org:443/r4//" ] ;
  mf:result [ cascade:serverBaseUrl "https://fhir.example.org/r4" ] .

<#base-url-http-default-port> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-http-default-port" ;
  rdfs:comment "http's default port is 80." ;
  mf:action [ cascade:serverBaseUrl "http://fhir.example.org:80/r4" ] ;
  mf:result [ cascade:serverBaseUrl "http://fhir.example.org/r4" ] .

<#base-url-other-port> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-other-port" ;
  rdfs:comment "Any other port is kept." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org:8443/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://fhir.example.org:8443/r4" ] .

<#base-url-empty-port> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-empty-port" ;
  rdfs:comment "An empty port is dropped." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org:/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://fhir.example.org/r4" ] .

<#base-url-dot-segments> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-dot-segments" ;
  rdfs:comment "Dot segments removed, RFC 3986 §5.2.4." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/a/./b/../r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://fhir.example.org/a/r4" ] .

<#base-url-percent-encoding> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-percent-encoding" ;
  rdfs:comment "A percent-encoded unreserved character decoded, any other's hex digits in upper case." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/%7e%41pi/a%7cb" ] ;
  mf:result [ cascade:serverBaseUrl "https://fhir.example.org/~Api/a%7Cb" ] .

<#base-url-host-alone> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-host-alone" ;
  rdfs:comment "A host alone, its trailing / removed." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/" ] ;
  mf:result [ cascade:serverBaseUrl "https://fhir.example.org" ] .

<#base-url-percent-encoded-host> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-percent-encoded-host" ;
  rdfs:comment "A host in lower case but for a percent-encoding's hex digits, which are upper case (RFC 3986 §6.2.2.1); an encoded unreserved character decoded, then lower-cased with the host." ;
  mf:action [ cascade:serverBaseUrl "https://%41PI.%c3%a9xample.ORG/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://api.%C3%A9xample.org/r4" ] .

<#base-url-ipv6> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-ipv6" ;
  rdfs:comment "A bracketed IPv6 address in lower case, and the scheme's default port dropped after it." ;
  mf:action [ cascade:serverBaseUrl "HTTPS://[2001:DB8::1]:443/r4/" ] ;
  mf:result [ cascade:serverBaseUrl "https://[2001:db8::1]/r4" ] .

<#base-url-ipv6-port> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-ipv6-port" ;
  rdfs:comment "A bracketed IPv6 address keeps any other port." ;
  mf:action [ cascade:serverBaseUrl "https://[::1]:8443/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://[::1]:8443/r4" ] .

<#base-url-ipvfuture> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-ipvfuture" ;
  rdfs:comment "An IPvFuture literal (RFC 3986 §3.2.2) is kept, in lower case." ;
  mf:action [ cascade:serverBaseUrl "https://[V1.Fe]/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://[v1.fe]/r4" ] .

<#base-url-port-leading-zeros-default> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-port-leading-zeros-default" ;
  rdfs:comment "A port is an integer (RFC 3986 section 3.2.3): 0443 is 443, https's default, so it is dropped." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org:0443/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://fhir.example.org/r4" ] .

<#base-url-port-leading-zeros> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-port-leading-zeros" ;
  rdfs:comment "Leading zeros are dropped from a port that is not the default." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org:08080/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://fhir.example.org:8080/r4" ] .

<#base-url-port-highest> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-port-highest" ;
  rdfs:comment "65535 is the highest port, and is kept." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org:65535/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://fhir.example.org:65535/r4" ] .

<#base-url-space> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-space" ;
  rdfs:comment "A space is refused." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/r 4" ] .

<#base-url-nul> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-nul" ;
  rdfs:comment "U+0000 is refused." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/r4\u0000" ] .

<#base-url-del> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-del" ;
  rdfs:comment "U+007F (DEL) is refused." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/r4\u007F" ] .

<#base-url-query> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-query" ;
  rdfs:comment "A query is refused: a server's base never has one, and a credential in it must never be a name input." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/r4?tok=abc" ] .

<#base-url-empty-query> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-empty-query" ;
  rdfs:comment "An empty query is refused too." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/r4?" ] .

<#base-url-fragment> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-fragment" ;
  rdfs:comment "A fragment is refused." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/r4#x" ] .

<#base-url-empty-fragment> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-empty-fragment" ;
  rdfs:comment "An empty fragment is refused too." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/r4#" ] .

<#base-url-userinfo> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-userinfo" ;
  rdfs:comment "A base URL carrying userinfo is refused: a credential is never a name input." ;
  mf:action [ cascade:serverBaseUrl "https://user@fhir.example.org/r4" ] .

<#base-url-port-not-digits> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-port-not-digits" ;
  rdfs:comment "A port that is not digits is refused." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org:https/r4" ] .

<#base-url-no-scheme> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-no-scheme" ;
  rdfs:comment "A base URL with no scheme is refused." ;
  mf:action [ cascade:serverBaseUrl "//fhir.example.org/r4" ] .

<#base-url-no-host> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-no-host" ;
  rdfs:comment "A base URL with no host is refused." ;
  mf:action [ cascade:serverBaseUrl "https:///r4" ] .

<#base-url-tab> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-tab" ;
  rdfs:comment "A tab is refused, not dropped as a URL parser drops it." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/r\t4" ] .

<#base-url-line-feed> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-line-feed" ;
  rdfs:comment "A line feed is refused, not dropped as a URL parser drops it." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org/r4\n" ] .

<#base-url-non-ascii-host> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-non-ascii-host" ;
  rdfs:comment "A host holding a non-ASCII character is refused: a source sends an IDN punycoded." ;
  mf:action [ cascade:serverBaseUrl "https://ΟΔΟΣ.example.org/r4" ] .

<#base-url-non-ascii-compatibility-host> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-non-ascii-compatibility-host" ;
  rdfs:comment "A host holding a compatibility character (U+2100) is refused, not folded." ;
  mf:action [ cascade:serverBaseUrl "https://a℀b/r4" ] .

<#base-url-bracket-unclosed> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-bracket-unclosed" ;
  rdfs:comment "A host opening a bracket it never closes is refused." ;
  mf:action [ cascade:serverBaseUrl "https://[abc/r4" ] .

<#base-url-bracket-unopened> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-bracket-unopened" ;
  rdfs:comment "A host closing a bracket it never opened is refused." ;
  mf:action [ cascade:serverBaseUrl "https://abc]/r4" ] .

<#base-url-bracket-not-ip> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-bracket-not-ip" ;
  rdfs:comment "A bracketed host that is neither IPv6 nor IPvFuture is refused." ;
  mf:action [ cascade:serverBaseUrl "https://[zzz]/r4" ] .

<#base-url-bracket-empty> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-bracket-empty" ;
  rdfs:comment "Empty brackets are refused." ;
  mf:action [ cascade:serverBaseUrl "https://[]/r4" ] .

<#base-url-ipv6-zone> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-ipv6-zone" ;
  rdfs:comment "A zone id is refused: RFC 3986 section 3.2.2 has none." ;
  mf:action [ cascade:serverBaseUrl "https://[fe80::1%25eth0]/r4" ] .

<#base-url-bad-percent-in-host> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-bad-percent-in-host" ;
  rdfs:comment "A host's % must open two hex digits." ;
  mf:action [ cascade:serverBaseUrl "https://a%zz.example.org/r4" ] .

<#base-url-port-non-ascii-digits> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-port-non-ascii-digits" ;
  rdfs:comment "A port is ASCII digits: Arabic-Indic digits are refused." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org:٤٤٣/r4" ] .

<#base-url-port-too-high> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-port-too-high" ;
  rdfs:comment "A port above 65535 is refused." ;
  mf:action [ cascade:serverBaseUrl "https://fhir.example.org:65536/r4" ] .

<#base-url-ipv6-zone-unencoded> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-ipv6-zone-unencoded" ;
  rdfs:comment "A zone id written with a bare % is refused, as the encoded one is: RFC 3986 has no zone id." ;
  mf:action [ cascade:serverBaseUrl "https://[fe80::1%eth0]/r4" ] .

<#base-url-encoded-slash-kept> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-encoded-slash-kept" ;
  rdfs:comment "An encoded reserved character is not decoded: %2F stays %2F, so a/b and a%2Fb are two bases." ;
  mf:action [ cascade:serverBaseUrl "https://h.example/a%2Fb/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://h.example/a%2Fb/r4" ] .

<#base-url-no-path> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-no-path" ;
  rdfs:comment "A base with no path is kept as written." ;
  mf:action [ cascade:serverBaseUrl "https://h.example" ] ;
  mf:result [ cascade:serverBaseUrl "https://h.example" ] .

<#base-url-port-zero> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-port-zero" ;
  rdfs:comment "Port 0 is a port, not an empty one: its leading zeros are dropped and :0 kept." ;
  mf:action [ cascade:serverBaseUrl "https://h.example:00000/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://h.example:0/r4" ] .

<#base-url-port-many-leading-zeros> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-port-many-leading-zeros" ;
  rdfs:comment "A port of more than five digits is read as an integer: :0000080 is :80, kept on https." ;
  mf:action [ cascade:serverBaseUrl "https://h.example:0000080/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://h.example:80/r4" ] .

<#base-url-encoded-dot-segments> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-encoded-dot-segments" ;
  rdfs:comment "An encoded dot segment is decoded, then removed as a dot segment." ;
  mf:action [ cascade:serverBaseUrl "https://h.example/a/%2e%2e/b/%2E/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://h.example/b/r4" ] .

<#base-url-dot-segments-above-root> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-dot-segments-above-root" ;
  rdfs:comment "A .. above the root is dropped." ;
  mf:action [ cascade:serverBaseUrl "https://h.example/%2e%2e/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://h.example/r4" ] .

<#base-url-percent-in-path-kept> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-percent-in-path-kept" ;
  rdfs:comment "A % not opening two hex digits is left alone in a path; in a host it is refused (base-url-bad-percent-in-host)." ;
  mf:action [ cascade:serverBaseUrl "https://h.example/a%zz/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://h.example/a%zz/r4" ] .

<#base-url-non-ascii-path-kept> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-non-ascii-path-kept" ;
  rdfs:comment "A path is not folded: a non-ASCII character in it is kept as written, beside its encoded form." ;
  mf:action [ cascade:serverBaseUrl "https://h.example/r%C3%A9/é" ] ;
  mf:result [ cascade:serverBaseUrl "https://h.example/r%C3%A9/é" ] .

<#base-url-ipv4-in-ipv6> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-ipv4-in-ipv6" ;
  rdfs:comment "An IPv6 address with an embedded IPv4 part is lower-cased and nothing else." ;
  mf:action [ cascade:serverBaseUrl "https://[::FFFF:1.2.3.4]/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://[::ffff:1.2.3.4]/r4" ] .

<#base-url-ipv6-http-default-port> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-ipv6-http-default-port" ;
  rdfs:comment "The scheme's default port is dropped after an IP-literal too." ;
  mf:action [ cascade:serverBaseUrl "http://[::1]:80/r4" ] ;
  mf:result [ cascade:serverBaseUrl "http://[::1]/r4" ] .

<#base-url-underscore-host> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-underscore-host" ;
  rdfs:comment "An underscore is an unreserved character, so a reg-name may hold one." ;
  mf:action [ cascade:serverBaseUrl "https://h_x.example/r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://h_x.example/r4" ] .

<#base-url-trailing-dot-host> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-trailing-dot-host" ;
  rdfs:comment "A host's trailing dot is kept: h.example. and h.example are two bases." ;
  mf:action [ cascade:serverBaseUrl "https://h.example./r4" ] ;
  mf:result [ cascade:serverBaseUrl "https://h.example./r4" ] .

<#base-url-other-scheme> a bridge:BaseUrlNormalisationTest ;
  mf:name "base-url-other-scheme" ;
  rdfs:comment "A scheme other than http and https is lower-cased and has no default port to drop." ;
  mf:action [ cascade:serverBaseUrl "ftp://h.example/r4" ] ;
  mf:result [ cascade:serverBaseUrl "ftp://h.example/r4" ] .

<#base-url-no-slashes> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-no-slashes" ;
  rdfs:comment "A URL with no // has no authority, so no host: refused." ;
  mf:action [ cascade:serverBaseUrl "https:h.example/r4" ] .

<#base-url-no-authority> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-no-authority" ;
  rdfs:comment "A scheme and a path with no authority: refused." ;
  mf:action [ cascade:serverBaseUrl "a:1:2" ] .

<#base-url-bracket-trailing> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-bracket-trailing" ;
  rdfs:comment "Text after a bracketed host that is not a port is refused." ;
  mf:action [ cascade:serverBaseUrl "https://[::1]x/r4" ] .

<#base-url-ipv6-too-many-groups> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-ipv6-too-many-groups" ;
  rdfs:comment "A bracketed host that is not an IPv6 address is refused." ;
  mf:action [ cascade:serverBaseUrl "https://[1:2:3:4:5:6:7:8:9]/r4" ] .

<#base-url-port-percent-encoded> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-port-percent-encoded" ;
  rdfs:comment "A percent-encoded port is not ASCII digits: refused." ;
  mf:action [ cascade:serverBaseUrl "https://h.example:%34%34%33/r4" ] .

<#base-url-angle-brackets-host> a bridge:BaseUrlRefusalTest ;
  mf:name "base-url-angle-brackets-host" ;
  rdfs:comment "A host holding a character a reg-name does not allow is refused." ;
  mf:action [ cascade:serverBaseUrl "https://<x>/r4" ] .
