@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:      <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt:      <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .

<> a mf:Manifest ;
  rdfs:label "naming vectors" ;
  mf:entries (
    <#record-from-server>
    <#record-from-server-on-another-server>
    <#record-from-server-percent-in-base>
    <#record-from-document>
    <#record-from-document-pipe-in-selector>
    <#record-from-document-pipe-in-document>
    <#record-from-document-escaped-pipe>
    <#record-from-ccda>
    <#record-from-ccda-another-patient>
    <#record-from-ccda-root-only>
    <#record-from-ccda-non-ascii-extension>
    <#record-from-ccda-bar-and-percent>
    <#record-from-ccda-patient>
    <#record-from-ccda-without-id>
    <#record-from-ccda-without-id-another-patient>
    <#record-from-ccda-without-id-members>
    <#record-from-ccda-without-id-or-fingerprint>
    <#contained-record>
    <#contained-record-last-updated>
    <#contained-record-no-source-version>
    <#contained-record-bar-and-percent>
    <#entered-record-first>
    <#entered-record-second>
    <#server>
    <#server-another>
    <#organization-from-server>
    <#organization-from-ccda-custodian>
    <#organization-from-fhir-identifier>
    <#assertion>
    <#retraction>
    <#table-row-ndc-to-rxnorm>
    <#table-row-rxnorm-to-medrt>
    <#table-row-rxnorm-to-unii>
    <#table-row-icd9-to-icd10>
    <#table-row-snomed-to-icd10>
    <#table-row-cpt-to-snomed>
    <#table-row-cvx-to-mesh>
    <#table-row-hgvs-to-clinvar>
    <#table-row-panel-member>
    <#table-row-panel-member-again>
    <#view-entry>
    <#claim>
    <#claim-star-with-a-table>
    <#claim-repeated-member-and-used>
    <#snapshot-first>
    <#snapshot-next>
    <#snapshot-merge>
    <#snapshot-merge-by-another-writer>
    <#version>
    <#version-nested-identifiers>
    <#version-literal-forms>
    <#version-language-tag-case>
    <#version-code-point-order>
    <#version-repeated-triple>
    <#revision>
    <#revision-with-selector>
    <#finding>
    <#table-version-first>
    <#table-version-revising>
    <#document-empty>
    <#document-json>
    <#document-xml>
    <#document-crlf>
    <#base-url-case>
    <#base-url-default-port-and-slashes>
    <#base-url-http-default-port>
    <#base-url-other-port>
    <#base-url-empty-port>
    <#base-url-dot-segments>
    <#base-url-percent-encoding>
    <#base-url-host-alone>
    <#base-url-percent-encoded-host>
    <#base-url-ipv6>
    <#base-url-ipv6-port>
    <#base-url-ipvfuture>
    <#base-url-port-leading-zeros-default>
    <#base-url-port-leading-zeros>
    <#base-url-port-highest>
    <#base-url-space>
    <#base-url-nul>
    <#base-url-del>
    <#base-url-query>
    <#base-url-empty-query>
    <#base-url-fragment>
    <#base-url-empty-fragment>
    <#base-url-userinfo>
    <#base-url-port-not-digits>
    <#base-url-no-scheme>
    <#base-url-no-host>
    <#base-url-tab>
    <#base-url-line-feed>
    <#base-url-non-ascii-host>
    <#base-url-non-ascii-compatibility-host>
    <#base-url-bracket-unclosed>
    <#base-url-bracket-unopened>
    <#base-url-bracket-not-ip>
    <#base-url-bracket-empty>
    <#base-url-ipv6-zone>
    <#base-url-bad-percent-in-host>
    <#base-url-port-non-ascii-digits>
    <#base-url-port-too-high>
    <#base-url-ipv6-zone-unencoded>
    <#base-url-encoded-slash-kept>
    <#base-url-no-path>
    <#base-url-port-zero>
    <#base-url-port-many-leading-zeros>
    <#base-url-encoded-dot-segments>
    <#base-url-dot-segments-above-root>
    <#base-url-percent-in-path-kept>
    <#base-url-non-ascii-path-kept>
    <#base-url-ipv4-in-ipv6>
    <#base-url-ipv6-http-default-port>
    <#base-url-underscore-host>
    <#base-url-trailing-dot-host>
    <#base-url-other-scheme>
    <#base-url-no-slashes>
    <#base-url-no-authority>
    <#base-url-bracket-trailing>
    <#base-url-ipv6-too-many-groups>
    <#base-url-port-percent-encoded>
    <#base-url-angle-brackets-host>
  ) .

<#record-from-server> a bridge:NamingTest ;
  mf:name "record-from-server" ;
  rdfs:comment "A FHIR resource read from a server: the normalised base URL the client used, the resource type, the id." ;
  bridge:namingRule cascade:RecordFromServerNamingRule ;
  mf:action [ qt:query <RecordFromServerNamingRule.rq> ; bridge:nameInputs ( "https://fhir.example.org/api/FHIR/R4" "AllergyIntolerance" "eQ3xk2RtVb7Lm9Pw1aZy8A3" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:81ad3fab-98f1-890c-8abe-e93c84afd9e0> ] .

<#record-from-server-on-another-server> a bridge:NamingTest ;
  mf:name "record-from-server-on-another-server" ;
  rdfs:comment "The same type and id on another server name another record." ;
  bridge:namingRule cascade:RecordFromServerNamingRule ;
  mf:action [ qt:query <RecordFromServerNamingRule.rq> ; bridge:nameInputs ( "https://fhir.other.example/r4" "AllergyIntolerance" "eQ3xk2RtVb7Lm9Pw1aZy8A3" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:482eb2d1-3697-8eff-bfb8-a1d3828964d0> ] .

<#record-from-server-percent-in-base> a bridge:NamingTest ;
  mf:name "record-from-server-percent-in-base" ;
  rdfs:comment "A % in an input is written %25 before the join, so the base's %7C is hashed as %257C." ;
  bridge:namingRule cascade:RecordFromServerNamingRule ;
  mf:action [ qt:query <RecordFromServerNamingRule.rq> ; bridge:nameInputs ( "https://fhir.example.org/tenant%7Cone" "Patient" "eM5vN8qTz2Hc4Rk7Jw0Pb3" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:3533e621-016a-807c-ae63-ecb15cbd744e> ] .

<#record-from-document> a bridge:NamingTest ;
  mf:name "record-from-document" ;
  rdfs:comment "A record from a document: the document's ni: name, then the rdf:value of the record's selector." ;
  bridge:namingRule cascade:RecordFromDocumentNamingRule ;
  mf:action [ qt:query <RecordFromDocumentNamingRule.rq> ; bridge:nameInputs ( "ni:///sha-256;K96dQ7NMCx_qaokgjdYAocBi7_dSJVtKQmYSfWR4rRc" "/entry/3" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:4404ca96-5724-8b33-a5b8-9ee8c40c53d1> ] .

<#record-from-document-pipe-in-selector> a bridge:NamingTest ;
  mf:name "record-from-document-pipe-in-selector" ;
  rdfs:comment "A | in an input is written %7C before the join: this vector and the next joined unescaped give one text, and their names differ." ;
  bridge:namingRule cascade:RecordFromDocumentNamingRule ;
  mf:action [ qt:query <RecordFromDocumentNamingRule.rq> ; bridge:nameInputs ( "ni:///sha-256;K96dQ7NMCx_qaokgjdYAocBi7_dSJVtKQmYSfWR4rRc" "a|b" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:e4781240-2d1f-8eb6-94c0-0127fe578fef> ] .

<#record-from-document-pipe-in-document> a bridge:NamingTest ;
  mf:name "record-from-document-pipe-in-document" ;
  rdfs:comment "The previous vector's join, \"ni:///sha-256;K96dQ7NMCx_qaokgjdYAocBi7_dSJVtKQmYSfWR4rRc|a|b\", split at the other bar." ;
  bridge:namingRule cascade:RecordFromDocumentNamingRule ;
  mf:action [ qt:query <RecordFromDocumentNamingRule.rq> ; bridge:nameInputs ( "ni:///sha-256;K96dQ7NMCx_qaokgjdYAocBi7_dSJVtKQmYSfWR4rRc|a" "b" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:608215e3-c82f-8360-be03-a82af1668f5a> ] .

<#record-from-document-escaped-pipe> a bridge:NamingTest ;
  mf:name "record-from-document-escaped-pipe" ;
  rdfs:comment "A selector holding the text %7C differs from one holding |: % is written %25 first." ;
  bridge:namingRule cascade:RecordFromDocumentNamingRule ;
  mf:action [ qt:query <RecordFromDocumentNamingRule.rq> ; bridge:nameInputs ( "ni:///sha-256;K96dQ7NMCx_qaokgjdYAocBi7_dSJVtKQmYSfWR4rRc" "a%7Cb" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:ddbdfd9c-e3d2-8fcb-a70e-3017c6bcba28> ] .

<#record-from-ccda> a bridge:NamingTest ;
  mf:name "record-from-ccda" ;
  rdfs:comment "A C-CDA entry: the custodian's id root and extension, the patient's id root and extension, the entry's id root and extension." ;
  bridge:namingRule cascade:RecordFromCcdaNamingRule ;
  mf:action [ qt:query <RecordFromCcdaNamingRule.rq> ; bridge:nameInputs ( "2.16.840.1.113883.19.5" "CLINIC-1" "2.16.840.1.113883.19.5.99" "MRN-1234" "2.16.840.1.113883.19.5" "8237461" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:bb2e2b2b-5b01-8991-aa76-984b9b06ed2c> ] .

<#record-from-ccda-another-patient> a bridge:NamingTest ;
  mf:name "record-from-ccda-another-patient" ;
  rdfs:comment "The same entry id for another patient at the same custodian names another record." ;
  bridge:namingRule cascade:RecordFromCcdaNamingRule ;
  mf:action [ qt:query <RecordFromCcdaNamingRule.rq> ; bridge:nameInputs ( "2.16.840.1.113883.19.5" "CLINIC-1" "2.16.840.1.113883.19.5.99" "MRN-5678" "2.16.840.1.113883.19.5" "8237461" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:0eaf6562-b4c8-830c-9983-b4b09e51a2e8> ] .

<#record-from-ccda-root-only> a bridge:NamingTest ;
  mf:name "record-from-ccda-root-only" ;
  rdfs:comment "An id with no extension gives the empty string as its extension." ;
  bridge:namingRule cascade:RecordFromCcdaNamingRule ;
  mf:action [ qt:query <RecordFromCcdaNamingRule.rq> ; bridge:nameInputs ( "2.16.840.1.113883.19.5" "" "2.16.840.1.113883.19.5.99" "MRN-1234" "1.2.3.4.5.6.7.8.9" "" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:b0ca738a-1177-8c6e-8183-3d9dd2ae6b3d> ] .

<#record-from-ccda-non-ascii-extension> a bridge:NamingTest ;
  mf:name "record-from-ccda-non-ascii-extension" ;
  rdfs:comment "Inputs are hashed as UTF-8: an extension with an accented letter and a character outside the Basic Multilingual Plane." ;
  bridge:namingRule cascade:RecordFromCcdaNamingRule ;
  mf:action [ qt:query <RecordFromCcdaNamingRule.rq> ; bridge:nameInputs ( "2.16.840.1.113883.19.5" "CLINIC-1" "2.16.840.1.113883.19.5.99" "MRN-1234" "2.16.840.1.113883.19.5" "Ñandú-7-🥜" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:e1ee9668-f67c-8b0a-9c98-9395426c062a> ] .

<#record-from-ccda-bar-and-percent> a bridge:NamingTest ;
  mf:name "record-from-ccda-bar-and-percent" ;
  rdfs:comment "An extension holding | and % is escaped before the join, | as %7C and % as %25." ;
  bridge:namingRule cascade:RecordFromCcdaNamingRule ;
  mf:action [ qt:query <RecordFromCcdaNamingRule.rq> ; bridge:nameInputs ( "2.16.840.1.113883.19.5" "CLINIC-1" "2.16.840.1.113883.19.5.99" "MRN-1234" "2.16.840.1.113883.19.5" "A|B%7C" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:7c477edc-2723-81ea-9301-ce15ffd32166> ] .

<#record-from-ccda-patient> a bridge:NamingTest ;
  mf:name "record-from-ccda-patient" ;
  rdfs:comment "The patient's own record: the custodian's id, then the patient's id as both the patient scope and the entry's id." ;
  bridge:namingRule cascade:RecordFromCcdaNamingRule ;
  mf:action [ qt:query <RecordFromCcdaNamingRule.rq> ; bridge:nameInputs ( "2.16.840.1.113883.19.5" "CLINIC-1" "2.16.840.1.113883.19.5.99" "MRN-1234" "2.16.840.1.113883.19.5.99" "MRN-1234" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:61535fef-9432-8aa6-9d00-45be6ad77330> ] .

<#record-from-ccda-without-id> a bridge:NamingTest ;
  mf:name "record-from-ccda-without-id" ;
  rdfs:comment "A C-CDA entry with no id: the custodian's id root and extension, the patient's id root and extension, the IRI of its record class, its key fingerprint, and \"\" for its members fingerprint, which a keyed entry does not use." ;
  bridge:namingRule cascade:RecordFromCcdaWithoutIdNamingRule ;
  mf:action [ qt:query <RecordFromCcdaWithoutIdNamingRule.rq> ; bridge:nameInputs ( "2.16.840.1.113883.19.5" "CLINIC-1" "2.16.840.1.113883.19.5.99" "MRN-1234" "https://ns.cascadeprotocol.org/cascade#AllergyOrIntolerance" "31544120" "" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:6dd926f0-4b6b-8c4f-8d23-22f2887e3b0e> ] .

<#record-from-ccda-without-id-another-patient> a bridge:NamingTest ;
  mf:name "record-from-ccda-without-id-another-patient" ;
  rdfs:comment "The same id-less statement for another patient of the same clinic names another record." ;
  bridge:namingRule cascade:RecordFromCcdaWithoutIdNamingRule ;
  mf:action [ qt:query <RecordFromCcdaWithoutIdNamingRule.rq> ; bridge:nameInputs ( "2.16.840.1.113883.19.5" "CLINIC-1" "2.16.840.1.113883.19.5.99" "MRN-5678" "https://ns.cascadeprotocol.org/cascade#AllergyOrIntolerance" "31544120" "" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:6852d889-9d64-8416-be6e-75ef19220181> ] .

<#record-from-ccda-without-id-members> a bridge:NamingTest ;
  mf:name "record-from-ccda-without-id-members" ;
  rdfs:comment "An id-less entry whose key fingerprint is absent or \"\": \"\" for the key, then its members fingerprint, so a key and a members fingerprint of one value name two records." ;
  bridge:namingRule cascade:RecordFromCcdaWithoutIdNamingRule ;
  mf:action [ qt:query <RecordFromCcdaWithoutIdNamingRule.rq> ; bridge:nameInputs ( "2.16.840.1.113883.19.5" "CLINIC-1" "2.16.840.1.113883.19.5.99" "MRN-1234" "https://ns.cascadeprotocol.org/cascade#AllergyOrIntolerance" "" "31544120" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:1ecaba18-53b4-8dc7-a139-a37458cc20de> ] .

<#record-from-ccda-without-id-or-fingerprint> a bridge:NamingTest ;
  mf:name "record-from-ccda-without-id-or-fingerprint" ;
  rdfs:comment "An id-less entry with neither fingerprint: its class alone inside the two scopes." ;
  bridge:namingRule cascade:RecordFromCcdaWithoutIdNamingRule ;
  mf:action [ qt:query <RecordFromCcdaWithoutIdNamingRule.rq> ; bridge:nameInputs ( "2.16.840.1.113883.19.5" "CLINIC-1" "2.16.840.1.113883.19.5.99" "MRN-1234" "https://ns.cascadeprotocol.org/cascade#AllergyOrIntolerance" "" "" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:0a7e03f4-d1b3-8b4f-af28-3e0100dc5be9> ] .

<#contained-record> a bridge:NamingTest ;
  mf:name "contained-record" ;
  rdfs:comment "A contained resource: its container's record name, the version id the source gives the container (meta.versionId), its id." ;
  bridge:namingRule cascade:ContainedRecordNamingRule ;
  mf:action [ qt:query <ContainedRecordNamingRule.rq> ; bridge:nameInputs ( "urn:uuid:7435b3b8-2d93-8912-9d48-940c5870dc81" "3" "r1" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:69f0ceda-f508-84a6-a393-9a2e67d62b11> ] .

<#contained-record-last-updated> a bridge:NamingTest ;
  mf:name "contained-record-last-updated" ;
  rdfs:comment "A container whose meta.versionId is absent or \"\" gives its meta.lastUpdated as written." ;
  bridge:namingRule cascade:ContainedRecordNamingRule ;
  mf:action [ qt:query <ContainedRecordNamingRule.rq> ; bridge:nameInputs ( "urn:uuid:7435b3b8-2d93-8912-9d48-940c5870dc81" "2026-03-01T10:00:00.000+00:00" "r1" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:e8e1e56b-adc0-89dd-bb4b-12a66c30100c> ] .

<#contained-record-no-source-version> a bridge:NamingTest ;
  mf:name "contained-record-no-source-version" ;
  rdfs:comment "A container with neither meta.versionId nor meta.lastUpdated, as a document's or an export's, gives the empty string." ;
  bridge:namingRule cascade:ContainedRecordNamingRule ;
  mf:action [ qt:query <ContainedRecordNamingRule.rq> ; bridge:nameInputs ( "urn:uuid:7435b3b8-2d93-8912-9d48-940c5870dc81" "" "r1" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:8c53f9d3-783c-8a5b-a8a7-c303c43ffa40> ] .

<#contained-record-bar-and-percent> a bridge:NamingTest ;
  mf:name "contained-record-bar-and-percent" ;
  rdfs:comment "A contained id holding | and % is escaped before the join." ;
  bridge:namingRule cascade:ContainedRecordNamingRule ;
  mf:action [ qt:query <ContainedRecordNamingRule.rq> ; bridge:nameInputs ( "urn:uuid:7435b3b8-2d93-8912-9d48-940c5870dc81" "3" "r|1%" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:d113c40a-3c47-891f-8772-ba63a909ae6c> ] .

<#entered-record-first> a bridge:NamingTest ;
  mf:name "entered-record-first" ;
  rdfs:comment "An entered record: the entry session's IRI, then the draft's position in decimal." ;
  bridge:namingRule cascade:EnteredRecordNamingRule ;
  mf:action [ qt:query <EnteredRecordNamingRule.rq> ; bridge:nameInputs ( "urn:uuid:7c2d9e41-5a8b-4f36-b0e2-9d1a4c6f8e53" "0" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:ef2c1a75-6fe6-8519-9b8f-b28657bb9fd9> ] .

<#entered-record-second> a bridge:NamingTest ;
  mf:name "entered-record-second" ;
  rdfs:comment "The session's next draft." ;
  bridge:namingRule cascade:EnteredRecordNamingRule ;
  mf:action [ qt:query <EnteredRecordNamingRule.rq> ; bridge:nameInputs ( "urn:uuid:7c2d9e41-5a8b-4f36-b0e2-9d1a4c6f8e53" "1" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:dc8440bd-3cd8-8104-b156-e1930256f127> ] .

<#server> a bridge:NamingTest ;
  mf:name "server" ;
  rdfs:comment "A server: the normalised base URL the client used." ;
  bridge:namingRule cascade:ServerNamingRule ;
  mf:action [ qt:query <ServerNamingRule.rq> ; bridge:nameInputs ( "https://fhir.example.org/api/FHIR/R4" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:dd6eca6e-29ec-851d-95aa-7cf63bd63366> ] .

<#server-another> a bridge:NamingTest ;
  mf:name "server-another" ;
  rdfs:comment "Another base URL names another server, even on the same host." ;
  bridge:namingRule cascade:ServerNamingRule ;
  mf:action [ qt:query <ServerNamingRule.rq> ; bridge:nameInputs ( "https://fhir.example.org/api/FHIR/R4/tenant-2" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:899a4a06-c93d-8352-b171-7b2a4a8cdcbb> ] .

<#organization-from-server> a bridge:NamingTest ;
  mf:name "organization-from-server" ;
  rdfs:comment "An organization read from a server: the normalised base URL, Organization, the resource's id." ;
  bridge:namingRule cascade:OrganizationNamingRule ;
  mf:action [ qt:query <OrganizationNamingRule.rq> ; bridge:nameInputs ( "https://fhir.example.org/api/FHIR/R4" "Organization" "org-1" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:801785a3-066b-86fb-84c1-2119dc670fce> ] .

<#organization-from-ccda-custodian> a bridge:NamingTest ;
  mf:name "organization-from-ccda-custodian" ;
  rdfs:comment "An organization a C-CDA document names: its custodian's id root and extension." ;
  bridge:namingRule cascade:OrganizationNamingRule ;
  mf:action [ qt:query <OrganizationNamingRule.rq> ; bridge:nameInputs ( "2.16.840.1.113883.4.6" "1234567893" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:f72b165e-be8b-81ab-a7f0-bc3bc6f5ed56> ] .

<#organization-from-fhir-identifier> a bridge:NamingTest ;
  mf:name "organization-from-fhir-identifier" ;
  rdfs:comment "An organization a FHIR document names: its Organization.identifier's system and value, as the document writes them; the C-CDA custodian's NPI above names another organization record, joined by a judgment." ;
  bridge:namingRule cascade:OrganizationNamingRule ;
  mf:action [ qt:query <OrganizationNamingRule.rq> ; bridge:nameInputs ( "http://hl7.org/fhir/sid/us-npi" "1234567893" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:b272d9d2-08db-8fd9-9d33-eca1e48c75ba> ] .

<#assertion> a bridge:NamingTest ;
  mf:name "assertion" ;
  rdfs:comment "An assertion: the rule list version, then the claim." ;
  bridge:namingRule cascade:AssertionNamingRule ;
  mf:action [ qt:query <AssertionNamingRule.rq> ; bridge:nameInputs ( "urn:uuid:9c1f5a73-2e48-4d6b-b8a0-3f7c1e9d5b24" "urn:uuid:5e4af5e8-b816-849e-9185-aed2981a566f" ) ] ;
  mf:result [ bridge:expectedName <urn:uuid:ea174059-aeb9-883e-bdfe-b786e4f582d5> ] .

<#retraction> a bridge:NamingTest ;
  mf:name "retraction" ;
  rdfs:comment "A release's retraction: the release, the claim, the matcher rule it declares wrong." ;
