@prefix ex:     <urn:example:catalog#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix pav:    <http://purl.org/pav/> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<urn:example:item:1> a ex:Item ; ex:title "First" .
<urn:example:item:2> a ex:Item .

<ni:///sha-256;kJbbG0Tc_OF62d4PyvYQbHkMRx39JhjjoiCLaRvGKhA> a prov:Entity ;
  bridge:serverBaseUrl "http://shop.example/Catalog" ;
  pav:retrievedFrom <http://shop.example/Catalog/items> .

[] a prov:Activity ;
  rdfs:label "a catalog import" ;
  prov:used <ni:///sha-256;kJbbG0Tc_OF62d4PyvYQbHkMRx39JhjjoiCLaRvGKhA> ;
  prov:qualifiedAssociation [
    prov:hadPlan [ a prov:Plan ; rdfs:label "catalog" ; pav:version "1" ] ;
    prov:agent [ rdfs:label "another Bridge" ; pav:version "0" ]
  ] .
