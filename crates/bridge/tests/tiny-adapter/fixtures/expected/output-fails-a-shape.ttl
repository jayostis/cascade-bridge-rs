@prefix ex:   <urn:example:catalog#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pav:  <http://purl.org/pav/> .

<urn:example:item:1> a ex:Item ;
  ex:title "ok" ;
  ex:code "longer" .

<ni:///sha-256;dx_K2GafZPdHVh3_liIMl_ULMSPY85kNcdIWXZBkuuE> a prov:Entity .

[] a prov:Activity ;
  prov:used <ni:///sha-256;dx_K2GafZPdHVh3_liIMl_ULMSPY85kNcdIWXZBkuuE> ;
  prov:qualifiedAssociation [
    prov:hadPlan [ a prov:Plan ; rdfs:label "catalog" ; pav:version "1" ] ;
    prov:agent [ ]
  ] .
