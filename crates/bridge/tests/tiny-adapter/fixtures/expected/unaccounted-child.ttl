@prefix ex:   <urn:example:catalog#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pav:  <http://purl.org/pav/> .

<urn:example:item:1> a ex:Item ; ex:title "First" .

<ni:///sha-256;v2hScoy3G8kmg5nFuUTXn7iXafRDmq2JP2bSlFGwEP8> a prov:Entity .

[] a prov:Activity ;
  prov:used <ni:///sha-256;v2hScoy3G8kmg5nFuUTXn7iXafRDmq2JP2bSlFGwEP8> ;
  prov:qualifiedAssociation [
    prov:hadPlan [ a prov:Plan ; rdfs:label "catalog" ; pav:version "1" ] ;
    prov:agent [ ]
  ] .
