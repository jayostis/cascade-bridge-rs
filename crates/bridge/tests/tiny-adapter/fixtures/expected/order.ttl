@prefix ex:   <urn:example:catalog#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pav:  <http://purl.org/pav/> .

<urn:example:item:a> a ex:Item .
<urn:example:item:b> a ex:Item ; ex:title "B" .

<ni:///sha-256;6NT-EYQpUIeEzUt_iZAJUd_hxT4CdBDKPDiD5Z5P7pE> a prov:Entity .

[] a prov:Activity ;
  prov:used <ni:///sha-256;6NT-EYQpUIeEzUt_iZAJUd_hxT4CdBDKPDiD5Z5P7pE> ;
  prov:qualifiedAssociation [
    prov:hadPlan [ a prov:Plan ; rdfs:label "catalog" ; pav:version "1" ] ;
    prov:agent [ ]
  ] .
