# The engine's own test subject: every outcome a harness can reach, each from
# the smallest input that reaches it. Two entries must fail.
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .

<> a mf:Manifest ;
  bridge:adapter <../> ;
  bridge:stampPredicate prov:generatedAtTime ;
  mf:entries ( <#pass> <#graph-fail> <#findings-fail> <#findings-repeated> <#census> <#input-only> <#dataset> ) .

# Passes only if the stamp in the expected graph is ignored.
<#pass> a bridge:IsomorphicConversionTest ;
  mf:name "pass" ;
  mf:action [ bridge:input <in/two.xml> ; bridge:envelope <../ro-crate-metadata.json#envelope-catalog> ] ;
  mf:result [ bridge:expectedGraph <expected/two.ttl> ; bridge:expectedFindings <findings/two.ttl> ] .

# One literal differs.
<#graph-fail> a bridge:IsomorphicConversionTest ;
  mf:name "graph-fail" ;
  mf:action [ bridge:input <in/two.xml> ; bridge:envelope <../ro-crate-metadata.json#envelope-catalog> ] ;
  mf:result [ bridge:expectedGraph <expected/two-wrong.ttl> ; bridge:expectedFindings <findings/two.ttl> ] .

# One of two findings a record produces twice is missing: a finding produced
# twice is two blank nodes and counts twice.
<#findings-fail> a bridge:IsomorphicConversionTest ;
  mf:name "findings-fail" ;
  mf:action [ bridge:input <in/order.xml> ; bridge:envelope <../ro-crate-metadata.json#envelope-catalog> ] ;
  mf:result [ bridge:expectedGraph <expected/order.ttl> ; bridge:expectedFindings <findings/order-missing-duplicate.ttl> ] .

# The same findings, the repeated one included.
<#findings-repeated> a bridge:IsomorphicConversionTest ;
  mf:name "findings-repeated" ;
  mf:action [ bridge:input <in/order.xml> ; bridge:envelope <../ro-crate-metadata.json#envelope-catalog> ] ;
  mf:result [ bridge:expectedGraph <expected/order.ttl> ; bridge:expectedFindings <findings/order.ttl> ] .

# The accounting says nothing about this input's novelty, and the census is
# the finding that says so.
<#census> a bridge:IsomorphicConversionTest ;
  mf:name "census" ;
  mf:action [ bridge:input <in/unaccounted-child.xml> ; bridge:envelope <../ro-crate-metadata.json#envelope-catalog> ] ;
  mf:result [ bridge:expectedGraph <expected/unaccounted-child.ttl> ; bridge:expectedFindings <findings/unaccounted-child.ttl> ] .

<#input-only> a bridge:InputOnlyTest ;
  mf:name "input-only" ;
  mf:action [ bridge:input <in/two.xml> ; bridge:envelope <../ro-crate-metadata.json#envelope-catalog> ] .

<#dataset> a bridge:DatasetCompletionTest ;
  mf:name "dataset" ;
  mf:action [ bridge:dataset <https://example.org/catalog-dump.xml> ; bridge:envelope <../ro-crate-metadata.json#envelope-catalog> ] .
